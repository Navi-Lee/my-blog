---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const pageTitle = `${SITE_TITLE} | 个人博客`;
const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: 1120px;
				padding: clamp(1.75rem, 3.6vw, 3.75rem) 1rem 5rem;
			}
			.hero {
				position: relative;
				display: grid;
				grid-template-columns: minmax(0, 1.45fr) minmax(260px, 0.7fr);
				gap: clamp(2rem, 6vw, 5.5rem);
				align-items: end;
				padding-bottom: clamp(3rem, 7vw, 5.5rem);
			}
			.section-kicker {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				margin: 0 0 1rem;
				color: var(--accent);
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.11em;
				text-transform: uppercase;
			}
			.hero h1 {
				max-width: 760px;
				/* Keep the original visual rhythm after removing the eyebrow copy. */
				margin: 2.35rem 0 0;
				font-size: clamp(3.25rem, 8vw, 6.6rem);
				line-height: 0.96;
				letter-spacing: -0.065em;
			}
			.hero h1 span {
				display: block;
				margin-top: 0.12em;
				color: var(--accent);
			}
			.hero-description {
				max-width: 610px;
				margin: 1.65rem 0 0;
				color: rgb(var(--gray-dark));
				font-size: clamp(1rem, 2vw, 1.2rem);
				line-height: 1.75;
			}
			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 2rem;
			}
			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 46px;
				padding: 0.65rem 1rem;
				border: 1px solid rgb(var(--border));
				border-radius: 12px;
				background: rgba(var(--surface), 0.75);
				color: rgb(var(--black));
				font-size: 0.9rem;
				font-weight: 700;
				transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
			}
			.button.primary {
				border-color: var(--accent);
				background: var(--accent);
				color: white;
				box-shadow: 0 12px 30px color-mix(in srgb, var(--accent) 24%, transparent);
			}
			.button:hover {
				transform: translateY(-2px);
				border-color: var(--accent);
				color: var(--accent);
			}
			.button.primary:hover { color: white; }
			.profile-summary {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 1.45rem;
			}
			.profile-summary span {
				padding: 0.35rem 0.65rem;
				border: 1px solid rgb(var(--border));
				border-radius: 999px;
				background: rgba(var(--surface), 0.58);
				color: rgb(var(--gray-dark));
				font-size: 0.76rem;
				font-weight: 700;
				cursor: default;
				transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
			}
			.profile-summary span::before {
				content: '·';
				margin-right: 0.35rem;
				color: var(--accent);
			}
			.profile-summary span:hover {
				transform: translateY(-2px);
				border-color: var(--accent);
				box-shadow: 0 8px 18px rgba(var(--black), 0.09);
				color: var(--accent);
			}
			.terminal {
				position: relative;
				isolation: isolate;
				overflow: hidden;
				align-self: center;
				padding: 1rem 1.05rem 1.15rem;
				border: 1px solid rgba(143, 169, 255, 0.26);
				border-radius: 15px;
				background: linear-gradient(145deg, #17223a, #0c1220 72%);
				box-shadow: 0 22px 44px rgba(49, 94, 251, 0.2), 0 12px 26px rgba(8, 13, 28, 0.18);
				color: #dce5ff;
				font-family: var(--font-code);
				animation: terminal-float 6s ease-in-out infinite;
			}
			.terminal::before {
				content: '';
				position: absolute;
				inset: 0;
				background: radial-gradient(circle at 85% 10%, rgba(100, 134, 255, 0.2), transparent 42%);
				pointer-events: none;
			}
			.terminal > * { position: relative; z-index: 1; }
			.terminal-bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 1.15rem;
			}
			.terminal-dots { display: flex; gap: 0.38rem; }
			.terminal-dots i { width: 8px; height: 8px; border-radius: 50%; background: #ff6868; }
			.terminal-dots i:nth-child(2) { background: #ffca5d; }
			.terminal-dots i:nth-child(3) { background: #5edc8a; }
			.terminal-path {
				margin: 0;
				color: #8c9abb;
				font-size: 0.72rem;
				font-weight: 700;
			}
			.terminal-editor {
				display: block;
				width: 100%;
				height: 5.5rem;
				margin: 0;
				padding: 0;
				border: 0;
				outline: 0;
				overflow-y: auto;
				scrollbar-width: none;
				background: transparent;
				color: #dce5ff;
				font: inherit;
				font-size: clamp(0.72rem, 1.5vw, 0.86rem);
				line-height: 1.8;
				caret-color: #91a8ff;
				white-space: pre-wrap;
				word-break: break-word;
			}
			.terminal-editor::-webkit-scrollbar { display: none; }
			.terminal-editor::selection { background: rgba(110, 139, 255, 0.35); }
			.terminal-editor :global(.code-keyword) { color: #63c9ff; font-weight: 700; }
			.terminal-editor :global(.code-string) { color: #f0cf71; }
			.terminal-editor :global(.code-comment) { color: #a3b2d6; font-style: italic; }
			.terminal-editor :global(.code-function) { color: #c79cff; }
			.terminal-editor :global(.code-argument) { color: #ffb86b; }
			.terminal-editor :global(.code-method) { color: #73dfc1; }
			.terminal-editor :global(.code-operator) { color: #ff8db6; }
			.terminal-editor :global(.code-punctuation) { color: #aab8db; }
			.terminal-editor :global(.code-number) { color: #ffb86b; }
			@keyframes terminal-float {
				0%, 100% { transform: translateY(0); }
				50% { transform: translateY(-5px); }
			}
			@media (prefers-reduced-motion: reduce) {
				.terminal { animation: none; }
			}
			.latest {
				padding-top: clamp(2.5rem, 6vw, 4.5rem);
				border-top: 1px solid rgb(var(--border));
			}
			.section-heading {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1.5rem;
			}
			.section-heading h2 {
				margin: 0;
				font-size: clamp(2rem, 4vw, 3.1rem);
				letter-spacing: -0.045em;
			}
			.view-all { flex: 0 0 auto; font-size: 0.86rem; font-weight: 700; }
			.post-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1rem;
			}
			.post-card {
				display: flex;
				min-height: 235px;
				flex-direction: column;
				padding: 1.25rem;
				border: 1px solid rgb(var(--border));
				border-radius: var(--radius);
				background: rgba(var(--surface), 0.78);
				color: inherit;
				transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
			}
			.post-card:hover {
				transform: translateY(-4px);
				border-color: color-mix(in srgb, var(--accent) 50%, rgb(var(--border)));
				box-shadow: 0 18px 42px rgba(var(--black), 0.09);
				color: inherit;
			}
			.post-meta {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				color: rgb(var(--gray));
				font-size: 0.75rem;
			}
			.post-index { color: var(--accent); font-weight: 700; }
			.post-card h3 {
				margin: 1.1rem 0 0.7rem;
				font-size: 1.25rem;
				line-height: 1.35;
				letter-spacing: -0.02em;
			}
			.post-card p {
				display: -webkit-box;
				overflow: hidden;
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.86rem;
				line-height: 1.65;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 2;
			}
			.post-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: auto; padding-top: 1rem; }
			.post-tags span {
				padding: 0.18rem 0.5rem;
				border-radius: 999px;
				background: rgba(var(--accent-soft), 0.72);
				color: var(--accent);
				font-size: 0.68rem;
				font-weight: 700;
			}
			@media (max-width: 820px) {
				.hero { grid-template-columns: 1fr; }
				.terminal { display: none; }
				.post-grid { grid-template-columns: 1fr; }
				.post-card { min-height: 190px; }
			}
			@media (max-width: 520px) {
				main { padding: 1.65rem 0.875rem 3.5rem; }
				.hero { gap: 2.25rem; padding-bottom: 3.25rem; }
				.hero h1 { font-size: clamp(3rem, 15vw, 4.2rem); }
				.hero-description { margin-top: 1.25rem; }
				.profile-summary { margin-top: 1.1rem; }
				.section-heading { align-items: center; }
				.section-heading h2 { font-size: 2rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-labelledby="intro-title">
				<div>
					<h1 id="intro-title">Hi, I'm <span>Navi Lee.</span></h1>
					<p class="hero-description">软件工程本科在读，正在学习前端开发。我在这里blog我的日常，前端技术以及雅思的学习。</p>
					<div class="profile-summary" aria-label="个人资料">
						<span>太原理工大学 · 软件工程</span><span>2029 届本科</span><span>React / TypeScript</span><span>211 · 双一流</span>
					</div>
					<div class="hero-actions">
						<a class="button primary" href="/blog">阅读 Blog →</a>
						<a class="button" href="mailto:LeeNavi@foxmail.com">与我联系</a>
					</div>
				</div>
				<aside class="terminal" aria-label="可编辑代码终端">
					<div class="terminal-bar"><div class="terminal-dots" aria-hidden="true"><i></i><i></i><i></i></div><span class="terminal-path">~/navi</span></div>
					<pre id="terminal-editor" class="terminal-editor" contenteditable="true" role="textbox" aria-multiline="true" spellcheck="false" aria-label="编辑终端代码">const navilee = (effort) =&gt;&#123;
  res.push(effort)
&#125;</pre>
					</div>
				</aside>
			</section>
			<section class="latest" aria-labelledby="latest-title">
				<div class="section-heading">
					<div><p class="section-kicker">Recently published</p><h2 id="latest-title">最近在写</h2></div>
					<a class="view-all" href="/blog">查看全部 →</a>
				</div>
				<div class="post-grid">
					{recentPosts.map((post, index) => (
						<a class="post-card" href={`/blog/${post.id}/`}>
							<div class="post-meta"><span class="post-index">0{index + 1}</span><FormattedDate date={post.data.pubDate} /></div>
							<h3>{post.data.title}</h3>
							{post.data.description && <p>{post.data.description}</p>}
							<div class="post-tags">{post.data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}</div>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
		<script>
			const editor = document.querySelector<HTMLElement>('#terminal-editor');
			const defaultCode = "const navilee = (effort) =>{\n  res.push(effort)\n}";

			if (editor) {
				const escapeHtml = (value: string) => value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
				const highlightCode = (code: string) => {
					const tokenPattern = /('(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*")|(\b(?:const|let|var|function|return|async|await|if|else|for|while|new)\b)|(=>)|(\.[A-Za-z_$][\w$]*)|([A-Za-z_$][\w$]*)(?=\s*\()|([A-Za-z_$][\w$]*)(?=\s*(?:,|\)))|(\b\d+(?:\.\d+)?\b)|([{}()[\];,])|([=+\-*/!<>]+)/g;
					let result = '';
					let lastIndex = 0;
					for (const match of code.matchAll(tokenPattern)) {
						const index = match.index || 0;
						result += escapeHtml(code.slice(lastIndex, index));
						const className = match[1] ? 'code-string'
							: match[2] ? 'code-keyword'
							: match[3] || match[9] ? 'code-operator'
							: match[4] ? 'code-method'
							: match[5] ? 'code-function'
							: match[6] ? 'code-argument'
							: match[7] ? 'code-number'
							: 'code-punctuation';
						result += `<span class="${className}">${escapeHtml(match[0])}</span>`;
						lastIndex = index + match[0].length;
					}
					return result + escapeHtml(code.slice(lastIndex));
				};
				const highlight = (value: string) => value.split('\n').map((line) => {
					const commentStart = line.indexOf('//');
					const code = commentStart >= 0 ? line.slice(0, commentStart) : line;
					const comment = commentStart >= 0 ? line.slice(commentStart) : '';
					const coloredCode = highlightCode(code);
					return `${coloredCode}${comment ? `<span class="code-comment">${escapeHtml(comment)}</span>` : ''}`;
				}).join('\n');
				const setCode = (value: string) => { editor.innerHTML = highlight(value); };
				const getCaretOffset = () => {
					const selection = window.getSelection();
					if (!selection?.rangeCount) return 0;
					const range = selection.getRangeAt(0);
					const before = range.cloneRange();
					before.selectNodeContents(editor);
					before.setEnd(range.endContainer, range.endOffset);
					return before.toString().length;
				};
				const restoreCaret = (offset: number) => {
					const walker = document.createTreeWalker(editor, NodeFilter.SHOW_TEXT);
					let remaining = offset;
					let node = walker.nextNode();
					while (node) {
						if (remaining <= (node.textContent?.length || 0)) {
							const range = document.createRange();
							range.setStart(node, remaining);
							range.collapse(true);
							const selection = window.getSelection();
							selection?.removeAllRanges();
							selection?.addRange(range);
							return;
						}
						remaining -= node.textContent?.length || 0;
						node = walker.nextNode();
					}
				};
				const formatEditor = () => {
					const caretOffset = getCaretOffset();
					const value = editor.innerText;
					setCode(value);
					restoreCaret(caretOffset);
				};
				const insertLineBreak = () => {
					const selection = window.getSelection();
					if (!selection?.rangeCount) return;
					const range = selection.getRangeAt(0);
					range.deleteContents();
					const lineBreak = document.createTextNode('\n');
					range.insertNode(lineBreak);
					range.setStartAfter(lineBreak);
					range.collapse(true);
					selection.removeAllRanges();
					selection.addRange(range);
					formatEditor();
				};

				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				let typeCode: number | undefined;
				if (!reduceMotion) {
					setCode('');
					let index = 0;
					typeCode = window.setInterval(() => {
						setCode(defaultCode.slice(0, ++index));
						if (index >= defaultCode.length && typeCode) window.clearInterval(typeCode);
					}, 28);
				} else {
					setCode(defaultCode);
				}

				editor.addEventListener('focus', () => {
					if (typeCode) window.clearInterval(typeCode);
				});
				editor.addEventListener('keydown', (event) => {
					if (event.key === 'Enter') {
						event.preventDefault();
						if (typeCode) window.clearInterval(typeCode);
						insertLineBreak();
					}
				});
				editor.addEventListener('input', () => {
					if (typeCode) window.clearInterval(typeCode);
					formatEditor();
				});
			}
		</script>
	</body>
</html>
