---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const pageTitle = `${SITE_TITLE} | 个人博客`;
const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: 1120px;
				padding: clamp(3rem, 7vw, 6.5rem) 1rem 5rem;
			}
			.hero {
				position: relative;
				display: grid;
				grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.75fr);
				gap: clamp(2rem, 6vw, 5.5rem);
				align-items: end;
				padding-bottom: clamp(3rem, 7vw, 5.5rem);
			}
			.hero::before {
				content: '';
				position: absolute;
				top: -2.5rem;
				right: 4%;
				width: 11rem;
				height: 11rem;
				border-radius: 999px;
				background: radial-gradient(circle, color-mix(in srgb, var(--accent) 18%, transparent), transparent 70%);
				filter: blur(8px);
				pointer-events: none;
			}
			.eyebrow,
			.section-kicker {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				margin: 0 0 1rem;
				color: var(--accent);
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.11em;
				text-transform: uppercase;
			}
			.eyebrow::before,
			.section-kicker::before {
				content: '';
				width: 1.8rem;
				height: 2px;
				border-radius: 999px;
				background: currentColor;
			}
			.hero h1 {
				max-width: 760px;
				margin: 0;
				font-size: clamp(3.25rem, 8vw, 6.6rem);
				line-height: 0.96;
				letter-spacing: -0.065em;
			}
			.hero h1 span {
				display: block;
				margin-top: 0.12em;
				color: var(--accent);
			}
			.hero-description {
				max-width: 610px;
				margin: 1.65rem 0 0;
				color: rgb(var(--gray-dark));
				font-size: clamp(1rem, 2vw, 1.2rem);
				line-height: 1.75;
			}
			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 2rem;
			}
			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 46px;
				padding: 0.65rem 1rem;
				border: 1px solid rgb(var(--border));
				border-radius: 12px;
				background: rgba(var(--surface), 0.75);
				color: rgb(var(--black));
				font-size: 0.9rem;
				font-weight: 700;
				transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
			}
			.button.primary {
				border-color: var(--accent);
				background: var(--accent);
				color: white;
				box-shadow: 0 12px 30px color-mix(in srgb, var(--accent) 24%, transparent);
			}
			.button:hover {
				transform: translateY(-2px);
				border-color: var(--accent);
				color: var(--accent);
			}
			.button.primary:hover { color: white; }
			.profile-card {
				position: relative;
				padding: 1.35rem;
				border: 1px solid rgb(var(--border));
				border-radius: var(--radius);
				background: linear-gradient(145deg, rgba(var(--surface), 0.94), rgba(var(--accent-soft), 0.48));
				box-shadow: 0 18px 48px rgba(var(--black), 0.08);
			}
			.profile-card::after {
				content: '';
				position: absolute;
				top: 1.2rem;
				right: 1.2rem;
				width: 9px;
				height: 9px;
				border-radius: 50%;
				background: #42d392;
				box-shadow: 0 0 0 5px rgba(66, 211, 146, 0.12);
			}
			.profile-label {
				margin: 0 0 1.4rem;
				color: rgb(var(--gray));
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.profile-list { display: grid; gap: 1rem; margin: 0; }
			.profile-list div {
				display: grid;
				grid-template-columns: 4.2rem 1fr;
				gap: 0.75rem;
				align-items: baseline;
			}
			.profile-list dt { color: rgb(var(--gray)); font-size: 0.8rem; }
			.profile-list dd {
				margin: 0;
				color: rgb(var(--black));
				font-size: 0.92rem;
				font-weight: 700;
			}
			.badges { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.25rem; }
			.badge {
				display: inline-flex;
				align-items: center;
				min-height: 27px;
				padding: 0.2rem 0.65rem;
				border: 1px solid rgb(var(--border));
				border-radius: 999px;
				background: rgba(var(--surface), 0.65);
				color: rgb(var(--gray-dark));
				font-size: 0.72rem;
				font-weight: 700;
			}
			.latest {
				padding-top: clamp(2.5rem, 6vw, 4.5rem);
				border-top: 1px solid rgb(var(--border));
			}
			.section-heading {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1.5rem;
			}
			.section-heading h2 {
				margin: 0;
				font-size: clamp(2rem, 4vw, 3.1rem);
				letter-spacing: -0.045em;
			}
			.view-all { flex: 0 0 auto; font-size: 0.86rem; font-weight: 700; }
			.post-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1rem;
			}
			.post-card {
				display: flex;
				min-height: 235px;
				flex-direction: column;
				padding: 1.25rem;
				border: 1px solid rgb(var(--border));
				border-radius: var(--radius);
				background: rgba(var(--surface), 0.78);
				color: inherit;
				transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
			}
			.post-card:hover {
				transform: translateY(-4px);
				border-color: color-mix(in srgb, var(--accent) 50%, rgb(var(--border)));
				box-shadow: 0 18px 42px rgba(var(--black), 0.09);
				color: inherit;
			}
			.post-meta {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				color: rgb(var(--gray));
				font-size: 0.75rem;
			}
			.post-index { color: var(--accent); font-weight: 700; }
			.post-card h3 {
				margin: 1.1rem 0 0.7rem;
				font-size: 1.25rem;
				line-height: 1.35;
				letter-spacing: -0.02em;
			}
			.post-card p {
				display: -webkit-box;
				overflow: hidden;
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.86rem;
				line-height: 1.65;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 2;
			}
			.post-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: auto; padding-top: 1rem; }
			.post-tags span {
				padding: 0.18rem 0.5rem;
				border-radius: 999px;
				background: rgba(var(--accent-soft), 0.72);
				color: var(--accent);
				font-size: 0.68rem;
				font-weight: 700;
			}
			@media (max-width: 820px) {
				.hero { grid-template-columns: 1fr; }
				.profile-card { max-width: 520px; }
				.post-grid { grid-template-columns: 1fr; }
				.post-card { min-height: 190px; }
			}
			@media (max-width: 520px) {
				main { padding: 2.6rem 0.875rem 3.5rem; }
				.hero { gap: 2.25rem; padding-bottom: 3.25rem; }
				.hero h1 { font-size: clamp(3rem, 15vw, 4.2rem); }
				.hero-description { margin-top: 1.25rem; }
				.section-heading { align-items: center; }
				.section-heading h2 { font-size: 2rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-labelledby="intro-title">
				<div>
					<p class="eyebrow">Software · Notes · Growth</p>
					<h1 id="intro-title">Hi, I'm <span>Navi Lee.</span></h1>
					<p class="hero-description">软件工程专业在读，正在学习前端开发。我在这里记录技术实践、学习路径，以及生活中值得留下来的片段。</p>
					<div class="hero-actions">
						<a class="button primary" href="/blog">阅读 Blog →</a>
						<a class="button" href="mailto:LeeNavi@foxmail.com">与我联系</a>
					</div>
				</div>
				<aside class="profile-card" aria-label="个人信息">
					<p class="profile-label">Currently</p>
					<dl class="profile-list">
						<div><dt>学校</dt><dd>太原理工大学</dd></div>
						<div><dt>专业</dt><dd>软件工程</dd></div>
						<div><dt>方向</dt><dd>React / TypeScript</dd></div>
						<div><dt>年级</dt><dd>2029 届本科</dd></div>
					</dl>
					<div class="badges" aria-label="学校标签">
						<span class="badge">211</span><span class="badge">双一流</span><span class="badge">AI Enthusiast</span>
					</div>
				</aside>
			</section>
			<section class="latest" aria-labelledby="latest-title">
				<div class="section-heading">
					<div><p class="section-kicker">Recently published</p><h2 id="latest-title">最近在写</h2></div>
					<a class="view-all" href="/blog">查看全部 →</a>
				</div>
				<div class="post-grid">
					{recentPosts.map((post, index) => (
						<a class="post-card" href={`/blog/${post.id}/`}>
							<div class="post-meta"><span class="post-index">0{index + 1}</span><FormattedDate date={post.data.pubDate} /></div>
							<h3>{post.data.title}</h3>
							{post.data.description && <p>{post.data.description}</p>}
							<div class="post-tags">{post.data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}</div>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
