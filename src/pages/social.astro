---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`社交媒体 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.social-intro {
				margin-bottom: 2rem;
			}

			.social-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.25rem;
			}

			.social-card {
				display: flex;
				align-items: center;
				gap: 1rem;
				padding: 1.1rem 1.2rem;
				border: 1px solid rgba(var(--gray), 0.24);
				border-radius: 18px;
				background: rgba(var(--surface), 0.9);
				box-shadow: 0 10px 30px rgba(var(--black), 0.06);
				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease,
					border-color 0.2s ease;
			}

			.social-card:hover {
				transform: translateY(-2px);
				border-color: rgba(var(--gray), 0.38);
				box-shadow: 0 16px 36px rgba(var(--black), 0.1);
			}

			.logo-badge {
				flex: 0 0 auto;
				width: 52px;
				height: 52px;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 16px;
				background: linear-gradient(135deg, #ff4d6d 0%, #ff2347 100%);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25);
			}

			.logo-badge svg {
				width: 32px;
				height: 32px;
				display: block;
			}

			.card-content {
				min-width: 0;
			}

			.card-title {
				margin: 0 0 0.25rem;
				font-size: 1.05rem;
				color: rgb(var(--black));
			}

			.card-text {
				margin: 0;
				color: rgb(var(--gray-dark));
				font-size: 0.95rem;
			}

			:root[data-theme='dark'] .social-card {
				background: rgba(var(--surface), 0.92);
				border-color: rgba(var(--gray-dark), 0.16);
				box-shadow: 0 12px 30px rgba(0, 0, 0, 0.28);
			}

			:root[data-theme='dark'] .social-card:hover {
				border-color: rgba(var(--gray-dark), 0.28);
				box-shadow: 0 18px 40px rgba(0, 0, 0, 0.34);
			}

			@media (max-width: 900px) {
				.social-grid {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 520px) {
				.social-card {
					padding: 1rem;
					border-radius: 16px;
				}

				.logo-badge {
					width: 48px;
					height: 48px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>社交媒体</h1>
			<p class="social-intro">这里放一些我常用的平台。目前先把小红书放上来，后面也可以继续补充。</p>

			<section class="social-grid" aria-label="社交媒体列表">
				<article class="social-card">
					<div class="logo-badge" aria-hidden="true">
						<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
							<rect x="10" y="12" width="44" height="40" rx="13" fill="white" />
							<path
								d="M24.5 26.5C28.9 24.7 33.1 24.8 37.2 27.2"
								stroke="#FF2442"
								stroke-width="4.2"
								stroke-linecap="round"
							/>
							<path
								d="M22.5 34.2C28 31.6 34.1 31.5 40.1 34.6"
								stroke="#FF2442"
								stroke-width="4.2"
								stroke-linecap="round"
							/>
							<path
								d="M24.4 41.6H39.6"
								stroke="#FF2442"
								stroke-width="4.2"
								stroke-linecap="round"
							/>
						</svg>
					</div>
					<div class="card-content">
						<h2 class="card-title">小红书</h2>
						<p class="card-text">用户名：Navi在coding</p>
					</div>
				</article>
			</section>
		</main>
		<Footer />
	</body>
</html>
