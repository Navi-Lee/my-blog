---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const defaultCategory = '技术相关';

// Prepare posts data for client-side search
const postsData = posts.map(post => ({
	id: post.id,
	title: post.data.title,
	pubDate: post.data.pubDate.toISOString(),
	latestChangeDate: post.data.latestChangeDate ? post.data.latestChangeDate.toISOString() : null,
	heroImage: post.data.heroImage,
	description: post.data.description,
	tags: post.data.tags || [],
	classes: post.data.Class,
}));

const classes = [...new Set(posts.flatMap((post) => post.data.Class))].sort((a, b) => {
	if (a === '日常随笔') return -1;
	if (b === '日常随笔') return 1;
	return a.localeCompare(b, 'zh-CN');
});

const pageTitle = `Blog | ${SITE_TITLE}`;
const pageDescription = 'Navi Lee 的博客文章列表，包含软件工程学习、技术实践和日常随笔。';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<script>
			import Fuse from 'fuse.js';
			(window as any).Fuse = Fuse;
		</script>
		<style>
			main {
				width: 100%;
				max-width: 960px;
				margin: auto;
			}
			.search-container {
				margin-bottom: 2rem;
				padding: 1rem;
			}
			.category-filter {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.6rem;
				margin-bottom: 1.25rem;
			}
			.category-label {
				margin-right: 0.15rem;
				color: rgb(var(--gray));
				font-size: 0.9rem;
				font-weight: 600;
			}
			.category-btn {
				padding: 0.4rem 0.85rem;
				border: 1px solid rgba(var(--gray), 0.35);
				border-radius: 999px;
				background: rgb(var(--surface));
				color: rgb(var(--gray-dark));
				cursor: pointer;
				font: inherit;
				font-size: 0.85rem;
				line-height: 1.4;
				transition: 0.2s ease;
			}
			.category-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.category-btn.active {
				border-color: var(--accent);
				background: var(--accent);
				color: rgb(var(--surface));
			}
			.search-mode-toggle {
				display: flex;
				gap: 0.5rem;
				margin-bottom: 1rem;
			}
			.search-mode-btn {
				padding: 0.5rem 1rem;
				border: 2px solid rgb(var(--gray));
				border-radius: 6px;
				background: transparent;
				color: rgb(var(--gray-dark));
				cursor: pointer;
				font-size: 0.9rem;
				font-weight: 500;
				transition: all 0.2s ease;
			}
			.search-mode-btn:hover {
				border-color: rgb(var(--accent));
				color: rgb(var(--accent));
			}
			.search-mode-btn.active {
				background: #8ea8ff;
				color: #1a1a2e;
				border-color: #8ea8ff;
			}
			.search-input {
				width: 100% !important;
				padding: 0.75rem 1rem !important;
				font-size: 1rem !important;
				border: 2px solid rgb(var(--gray-light)) !important;
				border-radius: 8px !important;
				background: rgb(var(--surface)) !important;
				color: rgb(var(--gray-dark)) !important;
				transition: border-color 0.2s ease !important;
				font-family: inherit !important;
				box-sizing: border-box !important;
				appearance: none !important;
				-webkit-appearance: none !important;
				resize: none !important;
				line-height: 1.5 !important;
			}
			.search-input:focus {
				outline: none !important;
				border-color: rgb(var(--accent)) !important;
				box-shadow: none !important;
			}
			.search-input::placeholder {
				color: rgb(var(--gray)) !important;
				opacity: 1 !important;
			}
			.search-input:hover {
				border-color: rgb(var(--gray)) !important;
			}
			.search-input:disabled {
				opacity: 0.6 !important;
				cursor: not-allowed !important;
			}
			.pagefind-ui-container {
				display: none;
			}
			.pagefind-ui-container.active {
				display: block;
			}
			.tag-search-container.active {
				display: block;
			}
			.tag-search-container {
				display: none;
			}
			/* Pagefind UI customization - ensure complete match with tag search */
			:global(.pagefind-ui),
			:global(.pagefind-ui__search),
			:global(.pagefind-ui__search-input-wrapper),
			:global(.pagefind-ui__search-input),
			#pagefind-search {
				width: 100% !important;
				margin: 0 !important;
				padding: 0 !important;
				border: none !important;
				background: transparent !important;
				box-shadow: none !important;
			}
			:global(.pagefind-ui__search-input),
			#pagefind-search {
				width: 100% !important;
				padding: 0.75rem 1rem !important;
				font-size: 1rem !important;
				border: 2px solid rgb(var(--gray-light)) !important;
				border-radius: 8px !important;
				background: rgb(var(--surface)) !important;
				color: rgb(var(--gray-dark)) !important;
				transition: border-color 0.2s ease !important;
				font-family: inherit !important;
				box-sizing: border-box !important;
				appearance: none !important;
				-webkit-appearance: none !important;
				resize: none !important;
				line-height: 1.5 !important;
			}
			:global(.pagefind-ui__search-input):focus,
			#pagefind-search:focus {
				outline: none !important;
				border-color: rgb(var(--accent)) !important;
				box-shadow: none !important;
			}
			:global(.pagefind-ui__search-input)::placeholder,
			#pagefind-search::placeholder {
				color: rgb(var(--gray)) !important;
				opacity: 1 !important;
			}
			:global(.pagefind-ui__search-input):hover,
			#pagefind-search:hover {
				border-color: rgb(var(--gray)) !important;
			}
			:global(.pagefind-ui__search-input):disabled,
			#pagefind-search:disabled {
				opacity: 0.6 !important;
				cursor: not-allowed !important;
			}
			/* Search results styles */
			#pagefind-results {
				margin-top: 1rem;
				border-radius: 8px;
				overflow: hidden;
				background: rgb(var(--surface));
				border: 1px solid rgb(var(--gray-light));
			}
			.pagefind-result {
				padding: 1rem 1.25rem;
				border-bottom: 1px solid rgb(var(--gray-light));
				transition: background-color 0.2s ease;
			}
			.pagefind-result:last-child {
				border-bottom: none;
			}
			.pagefind-result:hover {
				background-color: rgba(var(--gray-light), 0.3);
			}
			.pagefind-result-title {
				display: block;
				color: rgb(var(--accent));
				font-size: 1.1rem;
				font-weight: 600;
				text-decoration: none;
				margin-bottom: 0.5rem;
				line-height: 1.4;
			}
			.pagefind-result-title:hover {
				text-decoration: underline;
			}
			.pagefind-result-excerpt {
				color: rgb(var(--gray-dark));
				font-size: 0.9rem;
				line-height: 1.6;
				margin: 0;
				word-break: break-word;
			}
			/* Highlight style */
			.pagefind-result-excerpt mark,
			:global(.pagefind-ui__result-excerpt) mark {
				background-color: #ffeb3b;
				color: rgb(var(--black));
				padding: 0 2px;
				border-radius: 2px;
			}
			#posts-list {
				display: flex;
				flex-wrap: wrap;
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			#posts-list li {
				width: calc(50% - 0.75rem);
			}
			#posts-list li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			#posts-list li a {
				position: relative;
				display: flex;
				height: 100%;
				min-height: 100%;
				flex-direction: column;
				overflow: hidden;
				border: 1px solid rgba(var(--gray), 0.18);
				border-radius: 18px;
				background:
					linear-gradient(180deg, rgba(var(--surface), 0.95), rgba(var(--surface), 0.86)),
					rgb(var(--surface));
				box-shadow: 0 10px 28px rgba(var(--black), 0.06);
				color: inherit;
			}
			#posts-list li a::after {
				content: "";
				position: absolute;
				inset: 0;
				pointer-events: none;
				border-radius: inherit;
				background: none;
				opacity: 0;
			}
			#posts-list li img {
				display: block;
				width: 100%;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				border-radius: 0;
				border-bottom: 1px solid rgba(var(--gray), 0.14);
			}
			#posts-list li a > :not(img) {
				margin-inline: 1.15rem;
			}
			#posts-list li a > :last-child {
				margin-bottom: 1.15rem;
			}
			.title {
				margin-top: 1.1rem;
				margin-bottom: 0.55rem;
				color: rgb(var(--black));
				font-size: 1.2rem;
				line-height: 1.35;
				letter-spacing: 0;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.85rem;
				line-height: 1.5;
			}
			.pub-date,
			.update-date,
			.description {
				margin: 0;
			}
			.update-date {
				font-size: 0.9em;
			}
			.description {
				color: rgb(var(--gray));
				margin-top: 0.8rem;
				font-size: 0.92rem;
				line-height: 1.65;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			#posts-list li a:hover {
				transform: translateY(-4px);
				border-color: rgba(var(--accent), 0.45);
				box-shadow: 0 18px 42px rgba(var(--gray), 0.22);
			}
			#posts-list li a:hover::after {
				opacity: 1;
			}
			#posts-list li a:hover h4,
			#posts-list li a:hover .date {
				color: rgb(var(--accent));
			}
			#posts-list a:hover img {
				filter: saturate(1.08) contrast(1.03);
			}
			.no-results {
				text-align: center;
				color: rgb(var(--gray));
				padding: 2rem;
				width: 100%;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: auto;
				margin-bottom: 1.15rem;
				padding-top: 1rem;
			}
			.tag {
				background: rgba(var(--gray-light), 0.72);
				color: rgb(var(--gray-dark));
				padding: 0.24rem 0.62rem;
				border: 1px solid rgba(var(--gray), 0.12);
				border-radius: 999px;
				font-size: 0.75rem;
				line-height: 1.2;
			}
			:root[data-theme='dark'] #posts-list li a {
				background:
					linear-gradient(180deg, rgba(20, 24, 38, 0.96), rgba(var(--surface), 0.92)),
					rgb(var(--surface));
				border-color: rgba(var(--gray-dark), 0.14);
				box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
			}
			:root[data-theme='dark'] #posts-list li a::after {
				background: linear-gradient(
					135deg,
					color-mix(in srgb, var(--accent) 12%, transparent),
					transparent 44%
				);
			}
			:root[data-theme='dark'] #posts-list li a:hover {
				border-color: rgba(var(--accent), 0.5);
				box-shadow: 0 18px 44px rgba(0, 0, 0, 0.36);
			}
			:root[data-theme='dark'] .tag {
				background: rgba(var(--gray-light), 0.68);
				border-color: rgba(var(--gray-dark), 0.1);
			}
			.pagination {
				display: none;
				justify-content: center;
				align-items: center;
				gap: 0.5rem;
				margin-top: 2rem;
				padding: 1rem;
			}
			.pagination button {
				min-width: 36px;
				height: 36px;
				padding: 0 0.75rem;
				border: 2px solid rgb(var(--gray));
				border-radius: 6px;
				background: transparent;
				color: rgb(var(--gray-dark));
				cursor: pointer;
				font-size: 0.9rem;
				font-weight: 500;
				transition: all 0.2s ease;
			}
			.pagination button:hover:not(:disabled) {
				border-color: rgb(var(--accent));
				color: rgb(var(--accent));
			}
			.pagination button.active {
				background: rgb(var(--accent));
				color: white;
				border-color: rgb(var(--accent));
			}
			.pagination button:disabled {
				opacity: 0.5;
				cursor: not-allowed;
			}
			.page-numbers {
				display: flex;
				gap: 0.3rem;
			}
			.page-numbers button {
				min-width: 32px;
				height: 32px;
				padding: 0;
				border: 2px solid rgb(var(--gray));
				border-radius: 4px;
				background: transparent;
				color: rgb(var(--gray-dark));
				cursor: pointer;
				font-size: 0.85rem;
				font-weight: 500;
				transition: all 0.2s ease;
			}
			.page-numbers button:hover {
				border-color: rgb(var(--accent));
				color: rgb(var(--accent));
			}
			.page-numbers button.active {
				background: rgb(var(--accent));
				color: white;
				border-color: rgb(var(--accent));
			}
			.pagination-jump {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.pagination-jump input {
				width: 50px;
				padding: 0.5rem;
				border: 2px solid rgb(var(--gray-light));
				border-radius: 6px;
				background: rgb(var(--surface));
				color: rgb(var(--gray-dark));
				font-size: 0.9rem;
				text-align: center;
			}
			.pagination-jump input:focus {
				outline: none;
				border-color: rgb(var(--accent));
			}
			@media (max-width: 720px) {
				.search-container {
					margin-bottom: 1.25rem;
					padding: 0;
				}
				.search-mode-toggle {
					margin-bottom: 0.75rem;
				}
				.category-filter {
					gap: 0.5rem;
					margin-bottom: 1rem;
				}
				.category-label {
					width: 100%;
				}
				.search-mode-btn {
					flex: 1;
					padding: 0.55rem 0.65rem;
				}
				#posts-list {
					gap: 1rem;
				}
				#posts-list li {
					width: 100%;
				}
				#posts-list li a {
					border-radius: 16px;
				}
				#posts-list li a > :not(img) {
					margin-inline: 0.875rem;
				}
				.title {
					font-size: 1.12rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="search-container">
					<div class="category-filter" aria-label="按分类筛选文章">
						<span class="category-label">分类</span>
						<button type="button" class:list={['category-btn', { active: defaultCategory === '全部' }]} data-category="全部" aria-pressed={defaultCategory === '全部'}>全部</button>
						{classes.map((category) => (
							<button type="button" class:list={['category-btn', { active: category === defaultCategory }]} data-category={category} aria-pressed={category === defaultCategory}>{category}</button>
						))}
					</div>
					<div class="search-mode-toggle">
						<button type="button" class="search-mode-btn active" data-mode="tag">标签标题搜索</button>
						<button type="button" class="search-mode-btn" data-mode="content">内容搜索</button>
					</div>
					
					<!-- Tag search -->
					<div class="tag-search-container active">
						<input 
							type="text" 
							id="tag-search-input" 
							class="search-input" 
							placeholder="搜索文章标题或标签..." 
							autocomplete="off"
						/>
					</div>
					
					<!-- Content search (Pagefind) -->
					<div class="pagefind-ui-container" id="pagefind-container">
						<input 
							type="search" 
							id="pagefind-search" 
							class="search-input" 
							placeholder="输入搜索内容..." 
							autocomplete="off"
						/>
						<div id="pagefind-results"></div>
					</div>
				</div>
				
				<ul id="posts-list">
					{
						posts.map((post) => (
							<li data-title={post.data.title} data-id={post.id} data-tags={JSON.stringify(post.data.tags || [])} data-classes={JSON.stringify(post.data.Class)}>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<div class="date">
										<div class="pub-date">
											<FormattedDate date={post.data.pubDate} />
										</div>
										{
											post.data.latestChangeDate && (
												<div class="update-date">
													更新于 <FormattedDate date={post.data.latestChangeDate} />
												</div>
											)
										}
									</div>
									<p class="description">{post.data.description}</p>
									{post.data.tags && post.data.tags.length > 0 && (
										<div class="tags">
											{post.data.tags.map((tag) => (
												<span class="tag">{tag}</span>
											))}
										</div>
									)}
								</a>
							</li>
						))
					}
				</ul>
				<div id="no-results" class="no-results" style="display: none;">
					没有找到匹配的文章
				</div>

				<div id="pagination" class="pagination">
					<button id="prev-page" disabled>上一页</button>
					<div id="page-numbers" class="page-numbers"></div>
					<button id="next-page" disabled>下一页</button>
					<div class="pagination-jump">
						<input type="number" id="page-input" min="1" placeholder="页码" />
						<button id="jump-btn">跳转</button>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script define:vars={{ postsData, defaultCategory }}>
			document.addEventListener('DOMContentLoaded', function() {
				const tagSearchInput = document.getElementById('tag-search-input');
				const postsList = document.getElementById('posts-list');
				const noResults = document.getElementById('no-results');
				const listItems = postsList.querySelectorAll('li');
				const tagSearchContainer = document.querySelector('.tag-search-container');
				const pagefindContainer = document.getElementById('pagefind-container');
				const modeButtons = document.querySelectorAll('.search-mode-btn');
				const pagination = document.getElementById('pagination');
				const prevPageBtn = document.getElementById('prev-page');
				const nextPageBtn = document.getElementById('next-page');
				const pageNumbersContainer = document.getElementById('page-numbers');
				const pageInput = document.getElementById('page-input');
				const jumpBtn = document.getElementById('jump-btn');
				const categoryButtons = document.querySelectorAll('.category-btn');

				const PAGE_SIZE = 10;
				let currentPage = 1;
				let totalPages = 1;
				let selectedCategory = defaultCategory;
				let filteredItems = Array.from(listItems);

				let pagefindLoaded = false;
				let pagefindInstance = null;

				function renderPageNumbers() {
					pageNumbersContainer.innerHTML = '';
					for (let i = 1; i <= totalPages; i++) {
						const btn = document.createElement('button');
						btn.textContent = i;
						if (i === currentPage) {
							btn.classList.add('active');
						}
						btn.addEventListener('click', () => showPage(i));
						pageNumbersContainer.appendChild(btn);
					}
				}

				function showPage(pageNum) {
					totalPages = Math.max(1, Math.ceil(filteredItems.length / PAGE_SIZE));
					currentPage = Math.max(1, Math.min(pageNum, totalPages));
					const start = (currentPage - 1) * PAGE_SIZE;
					const end = start + PAGE_SIZE;

					listItems.forEach((item) => {
						item.style.display = 'none';
					});
					filteredItems.forEach((item, index) => {
						item.style.display = (index >= start && index < end) ? 'list-item' : 'none';
					});

					prevPageBtn.disabled = currentPage === 1;
					nextPageBtn.disabled = currentPage === totalPages;
					pageInput.value = '';
					renderPageNumbers();
				}

				function showPagination(show) {
					pagination.style.display = show ? 'flex' : 'none';
				}

				const fuse = new Fuse(postsData, {
					keys: ['title', 'tags'],
					threshold: 0.4,
					ignoreLocation: true,
				});

				function isInSelectedCategory(post) {
					return selectedCategory === '全部' || post.classes.includes(selectedCategory);
				}

				function performTagSearch(query) {
					const categoryPosts = postsData.filter(isInSelectedCategory);
					if (!query.trim()) {
						const allowedIds = new Set(categoryPosts.map(post => post.id));
						filteredItems = Array.from(listItems).filter(item => allowedIds.has(item.getAttribute('data-id')));
						showPagination(true);
						showPage(1);
						noResults.style.display = filteredItems.length === 0 ? 'block' : 'none';
						return;
					}

					const results = fuse.search(query).filter(result => isInSelectedCategory(result.item));
					const matchedIds = new Set(results.map(r => r.item.id));
					filteredItems = Array.from(listItems).filter(item => matchedIds.has(item.getAttribute('data-id')));
					showPage(1);

					showPagination(false);
					noResults.style.display = results.length === 0 ? 'block' : 'none';
				}

				tagSearchInput.addEventListener('input', (e) => {
					performTagSearch(e.target.value);
				});

				categoryButtons.forEach(button => {
					button.addEventListener('click', () => {
						selectedCategory = button.getAttribute('data-category');
						categoryButtons.forEach(item => {
							const active = item === button;
							item.classList.toggle('active', active);
							item.setAttribute('aria-pressed', String(active));
						});

						if (tagSearchContainer.classList.contains('active')) {
							performTagSearch(tagSearchInput.value);
						} else {
							performContentSearch(document.getElementById('pagefind-search').value);
						}
					});
				});

				prevPageBtn.addEventListener('click', () => {
					showPage(currentPage - 1);
				});

				nextPageBtn.addEventListener('click', () => {
					showPage(currentPage + 1);
				});

				jumpBtn.addEventListener('click', () => {
					const pageNum = parseInt(pageInput.value, 10);
					if (!isNaN(pageNum)) {
						showPage(pageNum);
					}
				});

				pageInput.addEventListener('keypress', (e) => {
					if (e.key === 'Enter') {
						const pageNum = parseInt(pageInput.value, 10);
						if (!isNaN(pageNum)) {
							showPage(pageNum);
						}
					}
				});

				modeButtons.forEach(btn => {
					btn.addEventListener('click', async () => {
						const mode = btn.getAttribute('data-mode');
						
						modeButtons.forEach(b => b.classList.remove('active'));
						btn.classList.add('active');

						if (mode === 'tag') {
							tagSearchContainer.classList.add('active');
							pagefindContainer.classList.remove('active');
							if (!tagSearchInput.value.trim()) {
								showPagination(true);
								showPage(1);
							} else {
								performTagSearch(tagSearchInput.value);
							}
							noResults.style.display = 'none';
						} else {
							tagSearchContainer.classList.remove('active');
							pagefindContainer.classList.add('active');
							listItems.forEach(item => item.style.display = 'none');
							showPagination(false);
							noResults.style.display = 'none';
							
							if (!pagefindLoaded) {
								await loadPagefind();
							}
							if (pagefindLoaded) {
								performContentSearch(document.getElementById('pagefind-search').value);
							}
						}
					});
				});

				performTagSearch('');

				async function performContentSearch(query) {
					const resultsContainer = document.getElementById('pagefind-results');
					if (!query.trim()) {
						resultsContainer.innerHTML = '';
						return;
					}
					if (!pagefindInstance) return;

					const results = await pagefindInstance.search(query);
					const allData = await Promise.all(results.results.map(result => result.data()));
					const allowedIds = new Set(postsData.filter(isInSelectedCategory).map(post => post.id));
					const data = allData.filter(item => {
						const path = decodeURIComponent(new URL(item.url, window.location.origin).pathname);
						return Array.from(allowedIds).some(id => path === `/blog/${id}/` || path === `/blog/${id}`);
					}).slice(0, 10);

					if (data.length === 0) {
						resultsContainer.innerHTML = '<p class="no-results">没有找到匹配的内容</p>';
						return;
					}

					resultsContainer.innerHTML = data.map(item => {
						let excerpt = '';
						if (item.excerpt) {
							const fullExcerpt = item.excerpt;
							const highlightStart = fullExcerpt.indexOf('<mark>');
							const highlightEnd = fullExcerpt.indexOf('</mark>');
							if (highlightStart !== -1 && highlightEnd !== -1) {
								const desiredLength = 75;
								const halfLength = Math.floor(desiredLength / 2);
								let startPos = Math.max(0, highlightStart - halfLength);
								let endPos = Math.min(fullExcerpt.length, startPos + desiredLength);
								startPos = Math.max(0, endPos - desiredLength);
								excerpt = `${startPos > 0 ? '...' : ''}${fullExcerpt.substring(startPos, endPos)}${endPos < fullExcerpt.length ? '...' : ''}`;
							} else {
								excerpt = fullExcerpt.slice(0, 75) + (fullExcerpt.length > 75 ? '...' : '');
							}
						}
						return `
							<div class="pagefind-result">
								<a href="${item.url}" class="pagefind-result-title">${item.meta.title}</a>
								<p class="pagefind-result-excerpt">${excerpt}</p>
							</div>
						`;
					}).join('');
				}

				async function loadPagefind() {
					try {
						let pagefind;
						try {
							pagefind = await import('/pagefind/pagefind.js');
						} catch {
							pagefind = await import('/_pagefind/pagefind.js');
						}
						await pagefind.init();
						pagefindInstance = pagefind;
						pagefindLoaded = true;
						
						const searchInput = document.getElementById('pagefind-search');
						const resultsContainer = document.getElementById('pagefind-results');

						searchInput.addEventListener('input', (event) => performContentSearch(event.target.value));
					} catch (e) {
						console.error('Pagefind load failed:', e);
						pagefindContainer.innerHTML = '<p class="no-results">搜索功能暂时不可用</p>';
					}
				}
			});
		</script>
	</body>
</html>
