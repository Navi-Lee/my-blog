---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Prepare posts data for client-side search
const postsData = posts.map(post => ({
	id: post.id,
	title: post.data.title,
	pubDate: post.data.pubDate.toISOString(),
	latestChangeDate: post.data.latestChangeDate ? post.data.latestChangeDate.toISOString() : null,
	heroImage: post.data.heroImage,
	description: post.data.description,
	tags: post.data.tags || [],
}));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script is:inline src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0"></script>
		<style>
			main {
				width: 100%;
				max-width: 960px;
				margin: auto;
			}
			.search-container {
				margin-bottom: 2rem;
				padding: 1rem;
			}
			.search-mode-toggle {
				display: flex;
				gap: 0.5rem;
				margin-bottom: 1rem;
			}
			.search-mode-btn {
				padding: 0.5rem 1rem;
				border: 2px solid rgb(var(--gray));
				border-radius: 6px;
				background: transparent;
				color: rgb(var(--gray-dark));
				cursor: pointer;
				font-size: 0.9rem;
				font-weight: 500;
				transition: all 0.2s ease;
			}
			.search-mode-btn:hover {
				border-color: rgb(var(--accent));
				color: rgb(var(--accent));
			}
			.search-mode-btn.active {
				background: #8ea8ff;
				color: #1a1a2e;
				border-color: #8ea8ff;
			}
			.search-input {
				width: 100% !important;
				padding: 0.75rem 1rem !important;
				font-size: 1rem !important;
				border: 2px solid rgb(var(--gray-light)) !important;
				border-radius: 8px !important;
				background: rgb(var(--surface)) !important;
				color: rgb(var(--gray-dark)) !important;
				transition: border-color 0.2s ease !important;
				font-family: inherit !important;
				box-sizing: border-box !important;
				appearance: none !important;
				-webkit-appearance: none !important;
				resize: none !important;
				line-height: 1.5 !important;
			}
			.search-input:focus {
				outline: none !important;
				border-color: rgb(var(--accent)) !important;
				box-shadow: none !important;
			}
			.search-input::placeholder {
				color: rgb(var(--gray)) !important;
				opacity: 1 !important;
			}
			.search-input:hover {
				border-color: rgb(var(--gray)) !important;
			}
			.search-input:disabled {
				opacity: 0.6 !important;
				cursor: not-allowed !important;
			}
			.pagefind-ui-container {
				display: none;
			}
			.pagefind-ui-container.active {
				display: block;
			}
			.tag-search-container.active {
				display: block;
			}
			.tag-search-container {
				display: none;
			}
			/* Pagefind UI customization - ensure complete match with tag search */
			:global(.pagefind-ui),
			:global(.pagefind-ui__search),
			:global(.pagefind-ui__search-input-wrapper),
			:global(.pagefind-ui__search-input),
			#pagefind-search {
				width: 100% !important;
				margin: 0 !important;
				padding: 0 !important;
				border: none !important;
				background: transparent !important;
				box-shadow: none !important;
			}
			:global(.pagefind-ui__search-input),
			#pagefind-search {
				width: 100% !important;
				padding: 0.75rem 1rem !important;
				font-size: 1rem !important;
				border: 2px solid rgb(var(--gray-light)) !important;
				border-radius: 8px !important;
				background: rgb(var(--surface)) !important;
				color: rgb(var(--gray-dark)) !important;
				transition: border-color 0.2s ease !important;
				font-family: inherit !important;
				box-sizing: border-box !important;
				appearance: none !important;
				-webkit-appearance: none !important;
				resize: none !important;
				line-height: 1.5 !important;
			}
			:global(.pagefind-ui__search-input):focus,
			#pagefind-search:focus {
				outline: none !important;
				border-color: rgb(var(--accent)) !important;
				box-shadow: none !important;
			}
			:global(.pagefind-ui__search-input)::placeholder,
			#pagefind-search::placeholder {
				color: rgb(var(--gray)) !important;
				opacity: 1 !important;
			}
			:global(.pagefind-ui__search-input):hover,
			#pagefind-search:hover {
				border-color: rgb(var(--gray)) !important;
			}
			:global(.pagefind-ui__search-input):disabled,
			#pagefind-search:disabled {
				opacity: 0.6 !important;
				cursor: not-allowed !important;
			}
			/* Search results styles */
			#pagefind-results {
				margin-top: 1rem;
				border-radius: 8px;
				overflow: hidden;
				background: rgb(var(--surface));
				border: 1px solid rgb(var(--gray-light));
			}
			.pagefind-result {
				padding: 1rem 1.25rem;
				border-bottom: 1px solid rgb(var(--gray-light));
				transition: background-color 0.2s ease;
			}
			.pagefind-result:last-child {
				border-bottom: none;
			}
			.pagefind-result:hover {
				background-color: rgba(var(--gray-light), 0.3);
			}
			.pagefind-result-title {
				display: block;
				color: rgb(var(--accent));
				font-size: 1.1rem;
				font-weight: 600;
				text-decoration: none;
				margin-bottom: 0.5rem;
				line-height: 1.4;
			}
			.pagefind-result-title:hover {
				text-decoration: underline;
			}
			.pagefind-result-excerpt {
				color: rgb(var(--gray-dark));
				font-size: 0.9rem;
				line-height: 1.6;
				margin: 0;
				word-break: break-word;
			}
			/* Highlight style */
			.pagefind-result-excerpt mark,
			:global(.pagefind-ui__result-excerpt) mark {
				background-color: #ffeb3b;
				color: rgb(var(--black));
				padding: 0 2px;
				border-radius: 2px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				margin-bottom: 1rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			.pub-date,
			.update-date {
				margin: 0;
			}
			.update-date {
				font-size: 0.85em;
			}
			.description {
				margin: 0.75rem 0 0.5rem 0;
				color: rgb(var(--gray-dark));
				font-size: 0.9em;
				line-height: 1.5;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			.no-results {
				text-align: center;
				color: rgb(var(--gray));
				padding: 2rem;
				width: 100%;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 0.5rem;
			}
			.tag {
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				padding: 0.2rem 0.6rem;
				border-radius: 4px;
				font-size: 0.75rem;
			}
			.pagination {
				display: none;
				justify-content: center;
				align-items: center;
				gap: 0.5rem;
				margin-top: 2rem;
				padding: 1rem;
			}
			.pagination button {
				min-width: 36px;
				height: 36px;
				padding: 0 0.75rem;
				border: 2px solid rgb(var(--gray));
				border-radius: 6px;
				background: transparent;
				color: rgb(var(--gray-dark));
				cursor: pointer;
				font-size: 0.9rem;
				font-weight: 500;
				transition: all 0.2s ease;
			}
			.pagination button:hover:not(:disabled) {
				border-color: rgb(var(--accent));
				color: rgb(var(--accent));
			}
			.pagination button.active {
				background: rgb(var(--accent));
				color: white;
				border-color: rgb(var(--accent));
			}
			.pagination button:disabled {
				opacity: 0.5;
				cursor: not-allowed;
			}
			.page-numbers {
				display: flex;
				gap: 0.3rem;
			}
			.page-numbers button {
				min-width: 32px;
				height: 32px;
				padding: 0;
				border: 2px solid rgb(var(--gray));
				border-radius: 4px;
				background: transparent;
				color: rgb(var(--gray-dark));
				cursor: pointer;
				font-size: 0.85rem;
				font-weight: 500;
				transition: all 0.2s ease;
			}
			.page-numbers button:hover {
				border-color: rgb(var(--accent));
				color: rgb(var(--accent));
			}
			.page-numbers button.active {
				background: rgb(var(--accent));
				color: white;
				border-color: rgb(var(--accent));
			}
			.pagination-jump {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.pagination-jump input {
				width: 50px;
				padding: 0.5rem;
				border: 2px solid rgb(var(--gray-light));
				border-radius: 6px;
				background: rgb(var(--surface));
				color: rgb(var(--gray-dark));
				font-size: 0.9rem;
				text-align: center;
			}
			.pagination-jump input:focus {
				outline: none;
				border-color: rgb(var(--accent));
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="search-container">
					<div class="search-mode-toggle">
						<button type="button" class="search-mode-btn active" data-mode="tag">标签标题搜索</button>
						<button type="button" class="search-mode-btn" data-mode="content">内容搜索</button>
					</div>
					
					<!-- Tag search -->
					<div class="tag-search-container active">
						<input 
							type="text" 
							id="tag-search-input" 
							class="search-input" 
							placeholder="搜索文章标题或标签..." 
							autocomplete="off"
						/>
					</div>
					
					<!-- Content search (Pagefind) -->
					<div class="pagefind-ui-container" id="pagefind-container">
						<input 
							type="search" 
							id="pagefind-search" 
							class="search-input" 
							placeholder="输入搜索内容..." 
							autocomplete="off"
						/>
						<div id="pagefind-results"></div>
					</div>
				</div>
				
				<ul id="posts-list">
					{
						posts.map((post) => (
							<li data-title={post.data.title} data-id={post.id} data-tags={JSON.stringify(post.data.tags || [])}>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<div class="date">
										<div class="pub-date">
											<FormattedDate date={post.data.pubDate} />
										</div>
										{
											post.data.latestChangeDate && (
												<div class="update-date">
													更新于 <FormattedDate date={post.data.latestChangeDate} />
												</div>
											)
										}
									</div>
									<p class="description">{post.data.description}</p>
									{post.data.tags && post.data.tags.length > 0 && (
										<div class="tags">
											{post.data.tags.map((tag) => (
												<span class="tag">{tag}</span>
											))}
										</div>
									)}
								</a>
							</li>
						))
					}
				</ul>
				<div id="no-results" class="no-results" style="display: none;">
					没有找到匹配的文章
				</div>

				<div id="pagination" class="pagination">
					<button id="prev-page" disabled>上一页</button>
					<div id="page-numbers" class="page-numbers"></div>
					<button id="next-page" disabled>下一页</button>
					<div class="pagination-jump">
						<input type="number" id="page-input" min="1" placeholder="页码" />
						<button id="jump-btn">跳转</button>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script define:vars={{ postsData }}>
			document.addEventListener('DOMContentLoaded', function() {
				const tagSearchInput = document.getElementById('tag-search-input');
				const postsList = document.getElementById('posts-list');
				const noResults = document.getElementById('no-results');
				const listItems = postsList.querySelectorAll('li');
				const tagSearchContainer = document.querySelector('.tag-search-container');
				const pagefindContainer = document.getElementById('pagefind-container');
				const modeButtons = document.querySelectorAll('.search-mode-btn');
				const pagination = document.getElementById('pagination');
				const prevPageBtn = document.getElementById('prev-page');
				const nextPageBtn = document.getElementById('next-page');
				const pageNumbersContainer = document.getElementById('page-numbers');
				const pageInput = document.getElementById('page-input');
				const jumpBtn = document.getElementById('jump-btn');

				const PAGE_SIZE = 10;
				let currentPage = 1;
				let totalPages = Math.max(1, Math.ceil(listItems.length / PAGE_SIZE));

				let pagefindLoaded = false;
				let pagefindInstance = null;

				function renderPageNumbers() {
					pageNumbersContainer.innerHTML = '';
					for (let i = 1; i <= totalPages; i++) {
						const btn = document.createElement('button');
						btn.textContent = i;
						if (i === currentPage) {
							btn.classList.add('active');
						}
						btn.addEventListener('click', () => showPage(i));
						pageNumbersContainer.appendChild(btn);
					}
				}

				function showPage(pageNum) {
					currentPage = Math.max(1, Math.min(pageNum, totalPages));
					const start = (currentPage - 1) * PAGE_SIZE;
					const end = start + PAGE_SIZE;

					listItems.forEach((item, index) => {
						item.style.display = (index >= start && index < end) ? 'list-item' : 'none';
					});

					prevPageBtn.disabled = currentPage === 1;
					nextPageBtn.disabled = currentPage === totalPages;
					pageInput.value = '';
					renderPageNumbers();
				}

				function showPagination(show) {
					pagination.style.display = show ? 'flex' : 'none';
				}

				const fuse = new Fuse(postsData, {
					keys: ['title', 'tags'],
					threshold: 0.4,
					ignoreLocation: true,
				});

				function performTagSearch(query) {
					if (!query.trim()) {
						showPagination(true);
						showPage(1);
						noResults.style.display = 'none';
						return;
					}

					const results = fuse.search(query);
					const matchedIds = new Set(results.map(r => r.item.id));

					listItems.forEach(item => {
						const id = item.getAttribute('data-id');
						item.style.display = matchedIds.has(id) ? 'list-item' : 'none';
					});

					showPagination(false);
					noResults.style.display = results.length === 0 ? 'block' : 'none';
				}

				tagSearchInput.addEventListener('input', (e) => {
					performTagSearch(e.target.value);
				});

				prevPageBtn.addEventListener('click', () => {
					showPage(currentPage - 1);
				});

				nextPageBtn.addEventListener('click', () => {
					showPage(currentPage + 1);
				});

				jumpBtn.addEventListener('click', () => {
					const pageNum = parseInt(pageInput.value, 10);
					if (!isNaN(pageNum)) {
						showPage(pageNum);
					}
				});

				pageInput.addEventListener('keypress', (e) => {
					if (e.key === 'Enter') {
						const pageNum = parseInt(pageInput.value, 10);
						if (!isNaN(pageNum)) {
							showPage(pageNum);
						}
					}
				});

				modeButtons.forEach(btn => {
					btn.addEventListener('click', async () => {
						const mode = btn.getAttribute('data-mode');
						
						modeButtons.forEach(b => b.classList.remove('active'));
						btn.classList.add('active');

						if (mode === 'tag') {
							tagSearchContainer.classList.add('active');
							pagefindContainer.classList.remove('active');
							if (!tagSearchInput.value.trim()) {
								showPagination(true);
								showPage(1);
							} else {
								performTagSearch(tagSearchInput.value);
							}
							noResults.style.display = 'none';
						} else {
							tagSearchContainer.classList.remove('active');
							pagefindContainer.classList.add('active');
							listItems.forEach(item => item.style.display = 'none');
							showPagination(false);
							noResults.style.display = 'none';
							
							if (!pagefindLoaded) {
								await loadPagefind();
							}
						}
					});
				});

				showPagination(true);
				showPage(1);

				async function loadPagefind() {
					try {
						let pagefind;
						try {
							pagefind = await import('/pagefind/pagefind.js');
						} catch {
							pagefind = await import('/_pagefind/pagefind.js');
						}
						await pagefind.init();
						pagefindInstance = pagefind;
						pagefindLoaded = true;
						
						const searchInput = document.getElementById('pagefind-search');
						const resultsContainer = document.getElementById('pagefind-results');

						searchInput.addEventListener('input', async (e) => {
							const query = e.target.value;
							if (!query.trim()) {
								resultsContainer.innerHTML = '';
								return;
							}
							const results = await pagefindInstance.search(query);
							const data = await Promise.all(results.results.slice(0, 10).map(r => r.data()));
							
							if (data.length === 0) {
								resultsContainer.innerHTML = '<p class="no-results">没有找到匹配的内容</p>';
								return;
							}
							
							resultsContainer.innerHTML = data.map(item => {
								let excerpt = '';
								if (item.excerpt) {
									const fullExcerpt = item.excerpt;
									const highlightStart = fullExcerpt.indexOf('<mark>');
									const highlightEnd = fullExcerpt.indexOf('</mark>');
									
									if (highlightStart !== -1 && highlightEnd !== -1) {
										const highlightLength = highlightEnd - highlightStart - 6;
										const desiredLength = 75;
										const halfLength = Math.floor(desiredLength / 2);
										
										let startPos = Math.max(0, highlightStart - halfLength);
										let endPos = startPos + desiredLength;
										
										if (endPos > fullExcerpt.length) {
											endPos = fullExcerpt.length;
											startPos = Math.max(0, endPos - desiredLength);
										}
										
										excerpt = fullExcerpt.substring(startPos, endPos);
										
										if (startPos > 0 && !/[\s，。！？、；：]/.test(fullExcerpt[startPos - 1])) {
											const prevSpace = fullExcerpt.lastIndexOf(' ', startPos);
											if (prevSpace !== -1 && startPos - prevSpace < 20) {
												excerpt = '...' + fullExcerpt.substring(prevSpace + 1, endPos);
											} else {
												excerpt = '...' + excerpt;
											}
										}
										
										if (endPos < fullExcerpt.length && !/[\s，。！？、；：]/.test(fullExcerpt[endPos - 1])) {
											excerpt += '...';
										}
									} else {
										excerpt = fullExcerpt.slice(0, 75) + (fullExcerpt.length > 75 ? '...' : '');
									}
								}
								return `
									<div class="pagefind-result">
										<a href="${item.url}" class="pagefind-result-title">${item.meta.title}</a>
										<p class="pagefind-result-excerpt">${excerpt}</p>
									</div>
								`;
							}).join('');
						});
					} catch (e) {
						console.error('Pagefind load failed:', e);
						pagefindContainer.innerHTML = '<p class="no-results">搜索功能暂时不可用</p>';
					}
				}
			});
		</script>
	</body>
</html>
