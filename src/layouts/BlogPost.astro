---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import GiscusComments from '../components/GiscusComments.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR, SITE_TITLE, SITE_URL } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, latestChangeDate, heroImage } = Astro.props;
const pageTitle = title.includes(SITE_TITLE) ? title : `${title} | ${SITE_TITLE}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	name: pageTitle,
	headline: pageTitle,
	description,
	url: canonicalURL.toString(),
	datePublished: pubDate.toISOString(),
	dateModified: (latestChangeDate || pubDate).toISOString(),
	author: {
		'@type': 'Person',
		name: SITE_AUTHOR,
		url: SITE_URL,
	},
	publisher: {
		'@type': 'Person',
		name: SITE_AUTHOR,
		url: SITE_URL,
	},
	isPartOf: {
		'@type': 'WebSite',
		name: SITE_TITLE,
		url: SITE_URL,
	},
	image: heroImage ? new URL(heroImage.src, Astro.site).toString() : undefined,
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonicalURL.toString(),
	},
};
---

<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 760px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: clamp(2.5rem, 6vw, 5rem) 1em 2rem;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 2.5rem;
				padding: 0;
				text-align: left;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 1.25rem;
				font-size: clamp(2.6rem, 7vw, 5rem);
				line-height: 1.04;
				letter-spacing: -0.055em;
			}
			.date {
				display: flex;
				gap: 0.55rem;
				align-items: center;
				margin-bottom: 1rem;
				color: rgb(var(--gray));
				font-size: 0.82rem;
				font-weight: 700;
				letter-spacing: 0.03em;
			}
			.date::before {
				content: 'Published';
				color: var(--accent);
				text-transform: uppercase;
			}
			.last-updated-on {
				font-style: italic;
			}
			.title hr {
				width: 3.5rem;
				margin: 0;
				border-top: 3px solid var(--accent);
			}
			.prose :global(h2) {
				margin-top: 2.5rem;
				font-size: 1.75rem;
				letter-spacing: -0.025em;
			}
			.prose :global(h3) {
				margin-top: 2rem;
				font-size: 1.35rem;
			}
			@media (max-width: 720px) {
				main {
					padding: 0 0 2rem;
				}
				.hero-image img {
					border-radius: 0;
				}
				.prose {
					width: 100%;
					max-width: 100%;
					padding: 2rem 0.875rem 0;
				}
				.title {
					margin-bottom: 2rem;
					padding: 0;
				}
				.title h1 {
					font-size: clamp(2.25rem, 11vw, 3.35rem);
					line-height: 1.08;
				}
				.date {
					flex-wrap: wrap;
					gap: 0.35rem 0.55rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								latestChangeDate && (
									<div class="last-updated-on">
										更新于 <FormattedDate date={latestChangeDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
				<GiscusComments />
			</article>
		</main>
		<Footer />
	</body>
</html>
